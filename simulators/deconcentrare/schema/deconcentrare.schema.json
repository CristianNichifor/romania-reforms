{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cristiannichifor.github.io/romania-reforms/schema/deconcentrare.schema.json",
  "title": "Deconcentrated services on the eight development regions",
  "description": "The territorial deconcentrated services, grouped into families and reorganised from one office per county to one office per development region. The county to region map is reused from the justitie variant, not re-derived.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "title", "publisher", "period", "provenance", "families", "summary", "limitations"],
  "properties": {
    "$schema": { "type": "string" },
    "id": { "const": "deconcentrare-2025" },
    "title": { "type": "string" },
    "publisher": { "type": "string" },
    "period": { "type": "string" },
    "provenance": { "$ref": "provenance.schema.json#/$defs/provenance" },
    "families": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "name",
          "tier",
          "officesToday",
          "officesProposed",
          "counties",
          "byRegion"
        ],
        "properties": {
          "code": { "type": "string" },
          "name": { "type": "string" },
          "tier": {
            "enum": ["regional", "regional-de-facto", "special"],
            "description": "regional: one per county today, proposed one per development region. regional-de-facto: already organised on regions. special: neither."
          },
          "officesToday": { "type": "integer", "minimum": 0 },
          "officesProposed": { "type": "integer", "minimum": 0 },
          "counties": { "type": "array", "items": { "type": "string" } },
          "byRegion": {
            "type": "object",
            "additionalProperties": { "type": "array", "items": { "type": "string" } }
          }
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "deconcentratedOfficesTotal",
        "matchedOffices",
        "regionalFamilies",
        "officesTodayInRegionalFamilies",
        "officesProposedOnEightRegions",
        "reductionPercent",
        "municipalExcluded",
        "unmatched"
      ],
      "properties": {
        "deconcentratedOfficesTotal": { "type": "integer", "minimum": 0 },
        "matchedOffices": { "type": "integer", "minimum": 0 },
        "regionalFamilies": { "type": "integer", "minimum": 0 },
        "officesTodayInRegionalFamilies": { "type": "integer", "minimum": 0 },
        "officesProposedOnEightRegions": { "type": "integer", "minimum": 0 },
        "reductionPercent": { "type": "number" },
        "municipalExcluded": { "type": "integer", "minimum": 0 },
        "unmatched": { "type": "integer", "minimum": 0 }
      }
    },
    "municipalNames": { "type": "array", "items": { "type": "string" } },
    "unmatchedNames": { "type": "array", "items": { "type": "string" } },
    "limitations": {
      "type": "array",
      "items": { "$ref": "provenance.schema.json#/$defs/limitation" }
    }
  }
}
