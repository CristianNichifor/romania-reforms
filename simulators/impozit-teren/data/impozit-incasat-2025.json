  "limitations": [
    {
      "id": "incasat-nu-datorat",
      "text": "Execuția bugetară arată ce s-a încasat, nu ce s-a datorat. Nu conține drepturile constatate rămase neîncasate, așa că din ea nu se poate citi un grad de colectare — pentru asta ar trebui contul de execuție al veniturilor, care nu este publicat pe localități în această sursă.",
      "severity": "blocking",
      "affects": [
        "impozit-incasat",
        "impozit"
      ]
    },
    {
      "id": "raportul-nu-e-grad-de-colectare",
      "text": "Raportul dintre încasat și impozitul modelat aici amestecă patru lucruri: cota aleasă de consiliul local din intervalul legal, zona, rangul și scutirile din art. 464 — și abia la urmă colectarea. Este publicat ca verificare a benzii modelate, nu ca parametru, și nu este introdus în `--collection-rate`.",
      "severity": "blocking",
      "affects": [
        "impozit"
      ]
    },
    {
      "id": "anii-nu-coincid",
      "text": "Încasările sunt din 2025, iar grilele notariale și impozitul modelat sunt din edițiile pe care le-au publicat camerele — 2024, 2025 sau 2026, după județ. Comparația conține și diferența de an.",
      "severity": "material",
      "affects": [
        "impozit"
      ]
    }
  ]
