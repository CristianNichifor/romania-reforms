{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "randament-padure.schema.json",
  "title": "Randamentul terenului forestier",
  "description": "Recolta pe hectar × prețul masei lemnoase pe picior × (1 − costuri), împărțit la valoarea pădurii pe hectar. Dedus, nu măsurat: pădurea nu se arendează.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "title",
    "publisher",
    "counties",
    "period",
    "currency",
    "provenance",
    "assumptions",
    "summary",
    "counties_measured",
    "limitations"
  ],
  "$defs": {
    "band": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "low",
        "central",
        "high"
      ],
      "properties": {
        "low": {
          "type": "number"
        },
        "central": {
          "type": "number"
        },
        "high": {
          "type": "number"
        }
      }
    }
  },
  "properties": {
    "$schema": {
      "type": "string"
    },
    "id": {
      "type": "string",
      "pattern": "^randament-padure-[0-9]{4}$"
    },
    "title": {
      "type": "string"
    },
    "publisher": {
      "type": "string"
    },
    "counties": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^[A-Z]{1,2}$"
      }
    },
    "period": {
      "type": "string",
      "pattern": "^[0-9]{4}$"
    },
    "currency": {
      "const": "RON"
    },
    "provenance": {
      "$ref": "provenance.schema.json#/$defs/provenance"
    },
    "assumptions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stumpageLeiPerM3",
        "stumpageSource",
        "ownerCostShare",
        "ronPerEur"
      ],
      "properties": {
        "stumpageLeiPerM3": {
          "$ref": "#/$defs/band"
        },
        "stumpageSource": {
          "type": "string"
        },
        "ownerCostShare": {
          "$ref": "#/$defs/band"
        },
        "ronPerEur": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "counties",
        "yieldPercent",
        "nationalM3PerHaPerYear",
        "arableYieldPercentForComparison"
      ],
      "properties": {
        "counties": {
          "type": "integer",
          "minimum": 1
        },
        "yieldPercent": {
          "$ref": "#/$defs/band"
        },
        "nationalM3PerHaPerYear": {
          "type": "number",
          "minimum": 0
        },
        "arableYieldPercentForComparison": {
          "type": "number"
        }
      }
    },
    "counties_measured": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "county",
          "m3PerHaPerYear",
          "forestHa",
          "forestShareOfCountyPriced",
          "forestValueRonPerHa",
          "rentRonPerHaPerYear",
          "yieldPercent"
        ],
        "properties": {
          "county": {
            "type": "string",
            "pattern": "^[A-Z]{1,2}$"
          },
          "m3PerHaPerYear": {
            "type": "number",
            "minimum": 0
          },
          "forestHa": {
            "type": "number",
            "minimum": 0
          },
          "forestShareOfCountyPriced": {
            "type": "number",
            "minimum": 0,
            "maximum": 1,
            "description": "Cât din pădurea județului a primit efectiv un preț — restul nu intră nici la numărător, nici la numitor."
          },
          "forestValueRonPerHa": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "rentRonPerHaPerYear": {
            "$ref": "#/$defs/band"
          },
          "yieldPercent": {
            "$ref": "#/$defs/band"
          }
        }
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "provenance.schema.json#/$defs/limitation"
      }
    }
  }
}
