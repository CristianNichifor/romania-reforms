{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://cristiannichifor.github.io/romania-reforms/schema/avere-teren.schema.json",
    "title": "Land value in the national accounts, per country, as a ratio to GDP",
    "description": "The only outside check on this repository's headline. ESA 2010 carries land as balance-sheet asset AN.211 and a handful of member states compile it; divided by GDP it becomes a ratio comparable across countries. Romania does not report it, which is why this is a benchmark rather than a source. Both the western and the post-2004 peer group are published because the choice between them moves the implied figure from about 310 to about 630 mld EUR, and neither is the answer.",
    "type": "object",
    "additionalProperties": false,
    "required": [
        "id",
        "title",
        "publisher",
        "counties",
        "period",
        "currency",
        "provenance",
        "assumptions",
        "summary",
        "localities",
        "limitations"
    ],
    "properties": {
        "$schema": {
            "type": "string"
        },
        "id": {
            "type": "string",
            "pattern": "^avere-teren-[0-9]{4}$"
        },
        "title": {
            "type": "string"
        },
        "publisher": {
            "const": "Eurostat"
        },
        "counties": {
            "type": "array",
            "minItems": 1,
            "items": {
                "type": "string",
                "pattern": "^[A-Z]{1,2}$"
            }
        },
        "period": {
            "type": "string",
            "pattern": "^[0-9]{4}$"
        },
        "currency": {
            "const": "EUR"
        },
        "provenance": {
            "$ref": "provenance.schema.json#/$defs/provenance"
        },
        "assumptions": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "benchmarkYear",
                "romaniaGdpEur",
                "grouping"
            ],
            "properties": {
                "benchmarkYear": {
                    "type": "string",
                    "pattern": "^[0-9]{4}$"
                },
                "romaniaGdpEur": {
                    "type": "number",
                    "exclusiveMinimum": 0
                },
                "grouping": {
                    "description": "How the peer groups were drawn. Must be a rule fixed before the ratios were seen.",
                    "type": "string"
                }
            }
        },
        "summary": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "countries",
                "groups"
            ],
            "properties": {
                "countries": {
                    "type": "integer",
                    "minimum": 5
                },
                "groups": {
                    "type": "object",
                    "minProperties": 1,
                    "additionalProperties": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                            "countries",
                            "medianLandOverGdp",
                            "impliedRomaniaEur"
                        ],
                        "properties": {
                            "countries": {
                                "type": "integer",
                                "minimum": 1
                            },
                            "medianLandOverGdp": {
                                "type": "number",
                                "exclusiveMinimum": 0
                            },
                            "impliedRomaniaEur": {
                                "type": "number",
                                "exclusiveMinimum": 0
                            }
                        }
                    }
                }
            }
        },
        "localities": {
            "type": "array",
            "minItems": 5,
            "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                    "geo",
                    "landMeur",
                    "gdpMeur",
                    "landOverGdp",
                    "group"
                ],
                "properties": {
                    "geo": {
                        "type": "string",
                        "pattern": "^[A-Z]{2}$"
                    },
                    "landMeur": {
                        "type": "number",
                        "exclusiveMinimum": 0
                    },
                    "gdpMeur": {
                        "type": "number",
                        "exclusiveMinimum": 0
                    },
                    "landOverGdp": {
                        "type": "number",
                        "exclusiveMinimum": 0
                    },
                    "group": {
                        "enum": [
                            "est",
                            "vest"
                        ]
                    }
                }
            }
        },
        "limitations": {
            "type": "array",
            "minItems": 1,
            "items": {
                "$ref": "provenance.schema.json#/$defs/limitation"
            }
        }
    }
}
