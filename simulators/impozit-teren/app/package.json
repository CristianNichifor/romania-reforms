{
  "name": "impozit-teren-app",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "predev": "node scripts/copy-data.mjs",
    "dev": "vite",
    "prebuild": "node scripts/vendor-civic-css.mjs && node scripts/copy-data.mjs",
    "build": "tsc --noEmit && vite build",
    "postbuild": "node scripts/check-map-worker.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run src",
    "check:civic-css": "node scripts/vendor-civic-css.mjs",
    "update:civic-css": "node scripts/vendor-civic-css.mjs --update",
    "check:ui": "npm run check:civic-css && playwright test"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@playwright/test": "1.63.0",
    "@types/node": "^22.20.1",
    "typescript": "^5.6.3",
    "vite": "7.3.6",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "maplibre-gl": "^6.6.0"
  }
}
