{
  "name": "administrative-reform-simulator-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "eslint src tests",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --exclude 'tests/browser/**'",
    "check:civic-css": "node scripts/vendor-civic-css.mjs",
    "check:ui": "npm run check:civic-css && playwright test"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@eslint/js": "^9.14.0",
    "@playwright/test": "1.63.0",
    "@types/node": "^22.9.0",
    "eslint": "^9.14.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.14.0",
    "vite": "7.3.6",
    "vitest": "4.1.11"
  },
  "dependencies": {
    "maplibre-gl": "^6.6.0"
  }
}
