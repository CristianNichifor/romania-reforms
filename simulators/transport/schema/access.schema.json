{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cristiannichifor.github.io/romania-reforms/schema/access.schema.json",
  "title": "Journey time to the county seat, with and without coordinated transfers",
  "description": "A journey is a feeder, a wait, and a trunk. The wait is the part a timetable controls and the part a passenger notices most: uncoordinated it averages half the trunk headway, pulsed it is the minutes the trunk stands at the interchange. Both scenarios run the same buses over the same kilometres — the difference is entirely in when the departures are written.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "title", "publisher", "period", "provenance", "summary", "uats", "limitations"],
  "properties": {
    "$schema": { "type": "string" },
    "id": { "type": "string" },
    "title": { "type": "string" },
    "publisher": { "type": "string" },
    "period": { "type": "string" },
    "provenance": { "$ref": "provenance.schema.json#/$defs/provenance" },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["uats", "people", "trunkHeadwayMin", "waitUncoordinatedMin", "waitPulsedMin", "medianUncoordinatedMin", "medianPulsedMin", "within", "rail"],
      "properties": {
        "uats": { "type": "integer", "minimum": 1 },
        "people": { "type": "integer", "minimum": 1 },
        "trunkHeadwayMin": { "type": "number", "exclusiveMinimum": 0 },
        "waitUncoordinatedMin": { "type": "number", "minimum": 0 },
        "waitPulsedMin": { "type": "number", "minimum": 0 },
        "medianUncoordinatedMin": { "type": "number", "minimum": 0 },
        "medianPulsedMin": { "type": "number", "minimum": 0 },
        "within": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": ["uncoordinatedPct", "pulsedPct"],
            "properties": {
              "uncoordinatedPct": { "type": "number", "minimum": 0, "maximum": 100 },
              "pulsedPct": { "type": "number", "minimum": 0, "maximum": 100 }
            }
          }
        },
        "rail": {
          "description": "Kept out of the bus figures rather than blended into them. Rail reaches few places and transforms the ones it reaches; one merged median would report a four-minute improvement and describe neither half of that.",
          "type": "object",
          "additionalProperties": false,
          "required": ["headwayMin", "waitUncoordinatedMin", "commercialKmh", "uatsWithOption", "uatsFasterByRail", "peopleFasterByRail", "medianBestUncoordinatedMin", "medianBestPulsedMin", "withinBest"],
          "properties": {
            "headwayMin": { "type": "number", "exclusiveMinimum": 0 },
            "waitUncoordinatedMin": { "type": "number", "minimum": 0 },
            "commercialKmh": { "type": "number", "exclusiveMinimum": 0 },
            "uatsWithOption": {
              "description": "Both ends walkable. The ceiling on what rail can do at all here.",
              "type": "integer", "minimum": 0
            },
            "uatsFasterByRail": { "type": "integer", "minimum": 0 },
            "peopleFasterByRail": { "type": "integer", "minimum": 0 },
            "medianBestUncoordinatedMin": { "type": "number", "minimum": 0 },
            "medianBestPulsedMin": { "type": "number", "minimum": 0 },
            "withinBest": {
              "type": "object",
              "additionalProperties": {
                "type": "object",
                "additionalProperties": false,
                "required": ["uncoordinatedPct", "pulsedPct"],
                "properties": {
                  "uncoordinatedPct": { "type": "number", "minimum": 0, "maximum": 100 },
                  "pulsedPct": { "type": "number", "minimum": 0, "maximum": 100 }
                }
              }
            }
          }
        }
      }
    },
    "uats": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["siruta", "name", "county", "population", "feederMin", "trunkMin", "uncoordinatedMin", "pulsedMin", "railUncoordinatedMin", "railPulsedMin", "bestUncoordinatedMin", "bestPulsedMin", "mode"],
        "properties": {
          "siruta": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1 },
          "county": { "type": "string", "minLength": 1 },
          "population": { "type": "integer", "minimum": 0 },
          "feederMin": { "type": "number", "minimum": 0 },
          "trunkMin": { "type": "number", "minimum": 0 },
          "uncoordinatedMin": { "type": "number", "minimum": 0 },
          "pulsedMin": { "type": "number", "minimum": 0 },
          "railUncoordinatedMin": {
            "description": "null where no train is on offer — the station is too far at one end or the other. Required as a key so the absence is stated rather than inferred from a missing field.",
            "type": ["number", "null"], "minimum": 0
          },
          "railPulsedMin": { "type": ["number", "null"], "minimum": 0 },
          "bestUncoordinatedMin": { "type": "number", "minimum": 0 },
          "bestPulsedMin": { "type": "number", "minimum": 0 },
          "mode": {
            "description": "Which mode actually wins for this UAT under a pulse. The mode choice is an output of comparing two journeys, never an assumption about who rides what.",
            "enum": ["bus", "rail"]
          }
        }
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "provenance.schema.json#/$defs/limitation" }
    }
  }
}
