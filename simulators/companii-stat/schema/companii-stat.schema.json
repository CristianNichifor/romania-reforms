{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cristiannichifor.github.io/romania-reforms/schema/companii-stat.schema.json",
  "title": "State companies by activity, with a regional-operator scenario",
  "description": "Companies grouped by four-digit CAEN, with the network utilities proposed as one operator per development region. The tier assignment is a policy judgement, marked assumed.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "title", "publisher", "period", "provenance", "operatorRule", "clusters", "inFlightMergers", "summary", "limitations"],
  "properties": {
    "$schema": { "type": "string" },
    "id": { "const": "companii-stat" },
    "title": { "type": "string" },
    "publisher": { "type": "string" },
    "period": { "type": "string" },
    "provenance": { "$ref": "provenance.schema.json#/$defs/provenance" },
    "operatorRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["confidence", "note"],
      "properties": {
        "confidence": { "const": "assumed" },
        "note": { "type": "string" }
      }
    },
    "inFlightMergers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["cui", "name", "caen", "status"],
        "properties": {
          "cui": { "type": "integer" },
          "name": { "type": "string" },
          "caen": { "type": ["string", "null"] },
          "status": { "type": "string" }
        }
      }
    },
    "clusters": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["caen", "name", "companies", "employees", "headcountKnown", "micro", "revenueRon", "lossCount", "debtRon", "tier", "proposed"],
        "properties": {
          "caen": { "type": "string" },
          "name": { "type": "string" },
          "companies": { "type": "integer", "minimum": 0 },
          "employees": { "type": "number", "minimum": 0 },
          "headcountKnown": { "type": "integer", "minimum": 0 },
          "micro": { "type": "integer", "minimum": 0 },
          "revenueRon": { "type": "number", "minimum": 0 },
          "lossCount": { "type": "integer", "minimum": 0 },
          "debtRon": { "type": "number", "minimum": 0 },
          "tier": { "enum": ["regional", "local", "national", "other"] },
          "proposed": { "type": "integer", "minimum": 0 },
          "regions": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["region", "seatCounty", "absorber", "absorbedCount", "absorbed"],
              "properties": {
                "region": { "type": "string" },
                "seatCounty": { "type": "string" },
                "absorber": {
                  "type": ["object", "null"],
                  "additionalProperties": false,
                  "required": ["cui", "name", "employees"],
                  "properties": {
                    "cui": { "type": "integer" },
                    "name": { "type": "string" },
                    "employees": { "type": "number" }
                  }
                },
                "absorbedCount": { "type": "integer", "minimum": 0 },
                "absorbed": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["cui", "name", "county"],
                    "properties": {
                      "cui": { "type": "integer" },
                      "name": { "type": "string" },
                      "county": { "type": ["string", "null"] }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "companies",
        "clusters",
        "regionalClusters",
        "companiesInRegionalClusters",
        "operatorsProposedOnEightRegions",
        "reductionPercent",
        "microUnder20",
        "headcountKnown",
        "revenueRon",
        "lossMaking",
        "inFlightMergers"
      ],
      "properties": {
        "companies": { "type": "integer", "minimum": 0 },
        "clusters": { "type": "integer", "minimum": 0 },
        "regionalClusters": { "type": "integer", "minimum": 0 },
        "companiesInRegionalClusters": { "type": "integer", "minimum": 0 },
        "operatorsProposedOnEightRegions": { "type": "integer", "minimum": 0 },
        "reductionPercent": { "type": "number" },
        "microUnder20": { "type": "integer", "minimum": 0 },
        "headcountKnown": { "type": "integer", "minimum": 0 },
        "revenueRon": { "type": "number", "minimum": 0 },
        "lossMaking": { "type": "integer", "minimum": 0 },
        "inFlightMergers": { "type": "integer", "minimum": 0 }
      }
    },
    "limitations": {
      "type": "array",
      "items": { "$ref": "provenance.schema.json#/$defs/limitation" }
    }
  }
}
