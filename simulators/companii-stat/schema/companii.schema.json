{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cristiannichifor.github.io/romania-reforms/schema/companii.schema.json",
  "title": "State-company identity, headcount, financials, owner and subsidies",
  "description": "One row per state company: identity, registration, CAEN activity, status, official MFin headcount and financials, the owning authority from the AMEPIP list, and the reported 2025 subsidy.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "title",
    "publisher",
    "period",
    "provenance",
    "countySource",
    "financialsSource",
    "ownerSource",
    "subsidySource",
    "sourceChecksum",
    "dataQuality",
    "summary",
    "companies"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "id": { "const": "companii-stat-2025" },
    "title": { "type": "string" },
    "publisher": { "type": "string" },
    "period": { "type": "string" },
    "provenance": { "$ref": "provenance.schema.json#/$defs/provenance" },
    "countySource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "url", "license", "confidence", "note", "snapshotChecksum"],
      "properties": {
        "source": { "type": "string" },
        "url": { "type": "string" },
        "license": { "type": "string" },
        "confidence": { "type": "string" },
        "note": { "type": "string" },
        "snapshotChecksum": {
          "type": "object",
          "additionalProperties": false,
          "required": ["sha256", "file"],
          "properties": {
            "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
            "file": { "type": "string" }
          }
        }
      }
    },
    "financialsSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "url", "license", "confidence", "note", "snapshotChecksum"],
      "properties": {
        "source": { "type": "string" },
        "url": { "type": "string" },
        "license": { "type": "string" },
        "confidence": { "type": "string" },
        "note": { "type": "string" },
        "snapshotChecksum": {
          "type": "object",
          "additionalProperties": false,
          "required": ["sha256", "file"],
          "properties": {
            "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
            "file": { "type": "string" }
          }
        }
      }
    },
    "ownerSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "url", "license", "confidence", "note", "snapshotChecksum"],
      "properties": {
        "source": { "type": "string" },
        "url": { "type": "string" },
        "license": { "type": "string" },
        "confidence": { "type": "string" },
        "note": { "type": "string" },
        "snapshotChecksum": {
          "type": "object",
          "additionalProperties": false,
          "required": ["sha256", "file"],
          "properties": {
            "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
            "file": { "type": "string" }
          }
        }
      }
    },
    "subsidySource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "url", "license", "confidence", "note", "snapshotChecksum"],
      "properties": {
        "source": { "type": "string" },
        "url": { "type": "string" },
        "license": { "type": "string" },
        "confidence": { "type": "string" },
        "note": { "type": "string" },
        "snapshotChecksum": {
          "type": "object",
          "additionalProperties": false,
          "required": ["sha256", "file"],
          "properties": {
            "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
            "file": { "type": "string" }
          }
        }
      }
    },
    "sourceChecksum": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sha256", "file"],
      "properties": {
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "file": { "type": "string" }
      }
    },
    "dataQuality": {
      "type": "object",
      "additionalProperties": false,
      "required": ["headcountExcluded", "unmatchedCounties", "unmatchedOwners"],
      "properties": {
        "headcountExcluded": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["companyId", "cui", "name", "reported", "year", "reason"],
            "properties": {
              "companyId": { "type": "integer" },
              "cui": { "type": "integer" },
              "name": { "type": "string" },
              "reported": { "type": "number" },
              "year": { "type": "integer" },
              "reason": { "type": "string" }
            }
          }
        },
        "unmatchedCounties": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["cui", "name", "reportedCounty"],
            "properties": {
              "cui": { "type": "integer" },
              "name": { "type": "string" },
              "reportedCounty": { "type": ["string", "null"] }
            }
          }
        },
        "unmatchedOwners": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["cui", "name"],
            "properties": {
              "cui": { "type": "integer" },
              "name": { "type": "string" }
            }
          }
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["companies", "withHeadcount", "byStatus"],
      "properties": {
        "companies": { "type": "integer", "minimum": 0 },
        "withHeadcount": { "type": "integer", "minimum": 0 },
        "byStatus": { "type": "object", "additionalProperties": { "type": "integer" } }
      }
    },
    "companies": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "cui", "name", "registrationNumber", "caen", "status"],
        "properties": {
          "id": { "type": "integer" },
          "cui": { "type": "integer" },
          "name": { "type": "string" },
          "registrationNumber": { "type": "string" },
          "caen": { "type": ["string", "null"] },
          "status": { "type": "string" },
          "employees": { "type": "number" },
          "employeesYear": { "type": "integer" },
          "employeesSource": { "type": "string" },
          "county": { "type": "string" },
          "countySource": { "type": "string" },
          "revenueRon": { "type": ["number", "null"] },
          "netResultRon": { "type": ["number", "null"] },
          "debtRon": { "type": ["number", "null"] },
          "owner": { "type": ["string", "null"] },
          "ownerType": { "type": ["string", "null"] },
          "subsidyRon": { "type": ["number", "null"] }
        }
      }
    }
  }
}
