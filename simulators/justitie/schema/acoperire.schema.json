{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cristiannichifor.github.io/romania-reforms/schema/acoperire.schema.json",
  "title": "What the simulator checks, chapter by chapter",
  "description": "The paper's 19 chapters against what this simulator does with each: computed, quoted as the author's own text, or not covered. The last splits between chapters that could be built and chapters that are not quantities — collapsing those two would hide work in one direction and invent it in the other.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "title",
    "publisher",
    "period",
    "provenance",
    "counts",
    "chapters",
    "limitations"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "id": {
      "const": "acoperire"
    },
    "title": {
      "type": "string"
    },
    "publisher": {
      "type": "string"
    },
    "period": {
      "type": "string"
    },
    "provenance": {
      "$ref": "provenance.schema.json#/$defs/provenance"
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "simulat",
        "citat",
        "negacoperit",
        "buildable",
        "notAQuantity",
        "total"
      ],
      "properties": {
        "simulat": {
          "type": "integer",
          "minimum": 0
        },
        "citat": {
          "type": "integer",
          "minimum": 0
        },
        "negacoperit": {
          "type": "integer",
          "minimum": 0
        },
        "buildable": {
          "type": "integer",
          "minimum": 0
        },
        "notAQuantity": {
          "type": "integer",
          "minimum": 0
        },
        "total": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "chapters": {
      "type": "array",
      "minItems": 19,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "number",
          "title",
          "page",
          "simulated",
          "quoted",
          "status"
        ],
        "properties": {
          "number": {
            "type": "integer",
            "exclusiveMinimum": 0
          },
          "title": {
            "type": "string"
          },
          "page": {
            "description": "The body heading, not the contents entry.",
            "type": "integer",
            "exclusiveMinimum": 0
          },
          "simulated": {
            "description": "Document ids that compute part of this chapter. Every one must exist or the build fails.",
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "quoted": {
            "type": "boolean"
          },
          "gap": {
            "enum": [
              "buildable",
              "not-a-quantity",
              null
            ]
          },
          "why": {
            "type": [
              "string",
              "null"
            ]
          },
          "status": {
            "enum": [
              "simulat",
              "citat",
              "negacoperit"
            ]
          }
        }
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "provenance.schema.json#/$defs/limitation"
      }
    }
  }
}
