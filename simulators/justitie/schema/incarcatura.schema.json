{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cristiannichifor.github.io/romania-reforms/schema/incarcatura.schema.json",
  "title": "Caseload each of the 42 proposed first-instance courts would carry",
  "description": "The map says where every consolidated unit goes and the cost model says how many judges the country needs, but nothing said what any individual proposed court would have to judge. This routes the CSM's per-court volume through the legal arondare of HG 1217/2023 to communes, through the administrative model to consolidated units, and through arondare-noua to one of 42 seats. The split of a court's cases across its communes is weighted by population and that is an assumption; invariantShare measures how much of the national volume does not depend on it, by counting the courts whose whole territory lands at a single seat.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "title", "publisher", "period", "provenance", "summary", "courts", "limitations"],
  "properties": {
    "$schema": { "type": "string" },
    "id": { "const": "incarcatura-noua" },
    "title": { "type": "string" },
    "publisher": { "type": "string" },
    "period": { "type": "string" },
    "provenance": { "$ref": "provenance.schema.json#/$defs/provenance" },

    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "courtsBefore",
        "courtsAfter",
        "routedVolume",
        "nationalLevelOneVolume",
        "invariantVolume",
        "invariantShare",
        "splitVolume",
        "tribunalVolume",
        "totalVolume",
        "loadPerJudge",
        "judgesNeeded",
        "spreadToday",
        "spreadAfter",
        "spreadPerCapita",
        "busiest",
        "busiestVolume",
        "busiestShareOfTotal",
        "busiestJudges",
        "quietest",
        "quietestVolume",
        "unreachableVolume",
        "unreachableCommunes",
        "dormantCourts",
        "localitiesNotInModel"
      ],
      "properties": {
        "courtsBefore": { "type": "integer", "exclusiveMinimum": 0 },
        "courtsAfter": { "const": 42 },
        "routedVolume": { "type": "integer", "exclusiveMinimum": 0 },
        "nationalLevelOneVolume": { "type": "integer", "exclusiveMinimum": 0 },
        "invariantVolume": { "type": "integer", "minimum": 0 },
        "invariantShare": { "type": "number", "minimum": 0, "maximum": 1 },
        "splitVolume": { "type": "integer", "minimum": 0 },
        "tribunalVolume": { "type": "integer", "minimum": 0 },
        "totalVolume": { "type": "integer", "exclusiveMinimum": 0 },
        "loadPerJudge": { "type": "number", "exclusiveMinimum": 0 },
        "judgesNeeded": { "type": "number", "exclusiveMinimum": 0 },
        "spreadToday": { "$ref": "#/$defs/spread" },
        "spreadAfter": { "$ref": "#/$defs/spread" },
        "spreadPerCapita": { "$ref": "#/$defs/spread" },
        "busiest": { "type": "string" },
        "busiestVolume": { "type": "integer", "exclusiveMinimum": 0 },
        "busiestShareOfTotal": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
        "busiestJudges": { "type": "number", "exclusiveMinimum": 0 },
        "quietest": { "type": "string" },
        "quietestVolume": { "type": "integer", "exclusiveMinimum": 0 },
        "unreachableVolume": {
          "description": "Cases belonging to communes whose consolidated unit has no road to any seat — the Danube Delta. Counted, not reassigned.",
          "type": "integer",
          "minimum": 0
        },
        "unreachableCommunes": { "type": "integer", "minimum": 0 },
        "dormantCourts": {
          "description": "Courts the government decision defines but the CSM register does not report activity for.",
          "type": "array",
          "items": { "type": "string" }
        },
        "localitiesNotInModel": { "type": "integer", "minimum": 0 }
      }
    },

    "courts": {
      "type": "array",
      "minItems": 42,
      "maxItems": 42,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "siruta",
          "name",
          "county",
          "units",
          "population",
          "lowerVolume",
          "upperVolume",
          "volume",
          "judgesAtNationalLoad",
          "casesPerThousandPeople"
        ],
        "properties": {
          "siruta": { "type": "string" },
          "name": { "type": "string" },
          "county": { "type": "string", "minLength": 1, "maxLength": 2 },
          "units": { "type": "integer", "exclusiveMinimum": 0 },
          "population": { "type": "integer", "minimum": 0 },
          "lowerVolume": { "type": "integer", "minimum": 0 },
          "upperVolume": { "type": "integer", "minimum": 0 },
          "volume": { "type": "integer", "minimum": 0 },
          "judgesAtNationalLoad": { "type": "number", "minimum": 0 },
          "casesPerThousandPeople": { "type": ["number", "null"], "minimum": 0 }
        }
      }
    },

    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "provenance.schema.json#/$defs/limitation" }
    }
  },

  "$defs": {
    "spread": {
      "type": "object",
      "additionalProperties": false,
      "required": ["min", "max", "median", "maxOverMin", "p90OverP10"],
      "properties": {
        "min": { "type": "number", "exclusiveMinimum": 0 },
        "max": { "type": "number", "exclusiveMinimum": 0 },
        "median": { "type": "number", "exclusiveMinimum": 0 },
        "maxOverMin": { "type": "number", "exclusiveMinimum": 0 },
        "p90OverP10": { "type": "number", "exclusiveMinimum": 0 }
      }
    }
  }
}
