{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cristiannichifor.github.io/romania-reforms/schema/acces-servicii.schema.json",
  "title": "Distance to a court against distance to a hospital",
  "description": "The same consolidated units measured against four networks on one road graph: today's 175 judecatorii, the 42 proposed courts, located hospitals and OSM police stations. The baseline is what makes the proposed distance legible — without it, 38 km could be a doubling of today's travel or roughly what already exists.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "title",
    "publisher",
    "period",
    "provenance",
    "summary",
    "units",
    "limitations"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "id": {
      "const": "acces-servicii"
    },
    "title": {
      "type": "string"
    },
    "publisher": {
      "type": "string"
    },
    "period": {
      "type": "string"
    },
    "provenance": {
      "$ref": "provenance.schema.json#/$defs/provenance"
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "units",
        "comparableUnits",
        "comparablePeople",
        "meanMetresToCourt",
        "meanMetresToHospitalAtMost",
        "medianMetresToCourt",
        "medianMetresToHospitalAtMost",
        "seatsThatAreHospitalTowns",
        "seatsThatAreCourtTowns",
        "unitsFurtherFromCourt",
        "peopleFurtherFromCourt",
        "hospitalTowns",
        "healthAccessView",
        "healthProviderTowns",
        "healthAccessEligibleProviders",
        "healthAccessBlockedProviders",
        "healthAccessNamedExclusions",
        "healthPointAccessView",
        "healthPointAccessProviders",
        "healthPointAccessBlockedProviders",
        "healthPointAccessNamedExclusions",
        "healthPointAccessRowsWithDistance",
        "healthPointAccessDistanceMethod",
        "healthPointAccessMedianNearestMetres",
        "healthPointAccessPopulationWeightedMedianNearestMetres",
        "healthPointRoadAccessView",
        "healthPointRoadAccessSourceRows",
        "healthPointRoadAccessProviders",
        "healthPointRoadAccessBlockedProviders",
        "healthPointRoadAccessNamedExclusions",
        "healthPointRoadAccessRowsWithDistance",
        "healthPointRoadAccessDistanceMethod",
        "healthPointRoadAccessMedianNearestMetres",
        "healthPointRoadAccessPopulationWeightedMedianNearestMetres",
        "medianMetresToPoliceAtMost",
        "seatsThatArePoliceTowns",
        "policeTowns",
        "todayCourts",
        "medianMetresToTodayCourt",
        "medianMetresToProposedCourt",
        "seatsThatAreTodayCourtTowns",
        "allPeople",
        "meanMetresToTodayCourt",
        "meanMetresToProposedCourt",
        "unitsFurtherThanToday",
        "peopleFurtherThanToday",
        "unitsLosingTheirLocalCourt",
        "peopleLosingTheirLocalCourt",
        "beyond"
      ],
      "properties": {
        "units": {
          "type": "integer",
          "exclusiveMinimum": 0
        },
        "comparableUnits": {
          "type": "integer",
          "exclusiveMinimum": 0
        },
        "comparablePeople": {
          "type": "integer",
          "exclusiveMinimum": 0
        },
        "meanMetresToCourt": {
          "type": "number",
          "minimum": 0
        },
        "meanMetresToHospitalAtMost": {
          "description": "An upper bound. Unplotted hospitals can only shorten the real journey.",
          "type": "number",
          "minimum": 0
        },
        "medianMetresToCourt": {
          "type": "number",
          "minimum": 0
        },
        "medianMetresToHospitalAtMost": {
          "type": "number",
          "minimum": 0
        },
        "seatsThatAreHospitalTowns": {
          "description": "The comparison that cannot be an artefact of seat choice: one set of seats, both networks.",
          "type": "integer",
          "minimum": 0
        },
        "seatsThatAreCourtTowns": {
          "type": "integer",
          "minimum": 0
        },
        "unitsFurtherFromCourt": {
          "type": "integer",
          "minimum": 0
        },
        "peopleFurtherFromCourt": {
          "type": "integer",
          "minimum": 0
        },
        "hospitalTowns": {
          "type": "integer",
          "exclusiveMinimum": 0
        },
        "healthAccessView": {
          "const": "health-service-access-uat-2024-2026"
        },
        "healthProviderTowns": {
          "type": "integer",
          "exclusiveMinimum": 0
        },
        "healthAccessEligibleProviders": {
          "type": "integer",
          "exclusiveMinimum": 0
        },
        "healthAccessBlockedProviders": {
          "type": "integer",
          "minimum": 0
        },
        "healthAccessNamedExclusions": {
          "type": "integer",
          "minimum": 0
        },
        "healthPointAccessView": {
          "const": "health-point-access-2024-2026"
        },
        "healthPointAccessProviders": {
          "description": "Accepted provider points from the shared point-level health access view.",
          "type": "integer",
          "minimum": 0
        },
        "healthPointAccessBlockedProviders": {
          "description": "Providers excluded from point-distance calculations because they lack accepted point evidence.",
          "type": "integer",
          "minimum": 0
        },
        "healthPointAccessNamedExclusions": {
          "type": "integer",
          "minimum": 0
        },
        "healthPointAccessRowsWithDistance": {
          "description": "Consolidated service rows for which a nearest accepted provider point distance was computed.",
          "type": "integer",
          "minimum": 0
        },
        "healthPointAccessDistanceMethod": {
          "const": "straight-line"
        },
        "healthPointAccessMedianNearestMetres": {
          "type": "integer",
          "minimum": 0
        },
        "healthPointAccessPopulationWeightedMedianNearestMetres": {
          "type": "integer",
          "minimum": 0
        },
        "healthPointRoadAccessView": {
          "const": "health-point-road-access-uat-2024-2026"
        },
        "healthPointRoadAccessSourceRows": {
          "description": "Rows in the shared UAT road-proxy source view.",
          "type": "integer",
          "minimum": 1
        },
        "healthPointRoadAccessProviders": {
          "type": "integer",
          "minimum": 1
        },
        "healthPointRoadAccessBlockedProviders": {
          "type": "integer",
          "minimum": 0
        },
        "healthPointRoadAccessNamedExclusions": {
          "type": "integer",
          "minimum": 0
        },
        "healthPointRoadAccessRowsWithDistance": {
          "description": "Consolidated service rows matched to the shared UAT road-proxy view.",
          "type": "integer",
          "minimum": 0
        },
        "healthPointRoadAccessDistanceMethod": {
          "const": "road-graph-to-snap-node-plus-straight-line-offset"
        },
        "healthPointRoadAccessMedianNearestMetres": {
          "type": "integer",
          "minimum": 0
        },
        "healthPointRoadAccessPopulationWeightedMedianNearestMetres": {
          "type": "integer",
          "minimum": 0
        },
        "medianMetresToPoliceAtMost": {
          "type": "number",
          "minimum": 0,
          "description": "Upper bound: an unmapped station can only shorten the journey."
        },
        "seatsThatArePoliceTowns": {
          "type": "integer",
          "minimum": 0,
          "description": "Over every routed unit — police cover all 42 counties, so no exclusion applies."
        },
        "policeTowns": {
          "type": "integer",
          "exclusiveMinimum": 0
        },
        "todayCourts": {
          "description": "The judecatorii that exist now, located. The baseline the proposed figure means nothing without.",
          "type": "integer",
          "exclusiveMinimum": 0
        },
        "medianMetresToTodayCourt": {
          "type": "number",
          "minimum": 0
        },
        "medianMetresToProposedCourt": {
          "type": "number",
          "minimum": 0
        },
        "meanMetresToTodayCourt": {
          "type": "number",
          "minimum": 0
        },
        "meanMetresToProposedCourt": {
          "type": "number",
          "minimum": 0
        },
        "seatsThatAreTodayCourtTowns": {
          "type": "integer",
          "minimum": 0
        },
        "unitsFurtherThanToday": {
          "type": "integer",
          "minimum": 0
        },
        "peopleFurtherThanToday": {
          "type": "integer",
          "minimum": 0
        },
        "unitsLosingTheirLocalCourt": {
          "type": "integer",
          "minimum": 0,
          "description": "Units with a court in their own town today and a drive tomorrow."
        },
        "peopleLosingTheirLocalCourt": {
          "type": "integer",
          "minimum": 0
        },
        "allPeople": {
          "type": "integer",
          "minimum": 0
        },
        "beyond": {
          "description": "Units and people further than N km from a first-level court, now and under the proposal.",
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "todayUnits",
              "todayPeople",
              "proposedUnits",
              "proposedPeople"
            ],
            "properties": {
              "todayUnits": {
                "type": "integer",
                "minimum": 0
              },
              "todayPeople": {
                "type": "integer",
                "minimum": 0
              },
              "proposedUnits": {
                "type": "integer",
                "minimum": 0
              },
              "proposedPeople": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        }
      }
    },
    "units": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "siruta",
          "name",
          "county",
          "population",
          "courtMetres",
          "hospitalMetresAtMost",
          "localHealthProviderCount",
          "nearestHealthPointProviderId",
          "nearestHealthPointDistanceMetres",
          "nearestHealthPointRoadProviderId",
          "nearestHealthPointRoadProxyMetres",
          "comparable",
          "policeMetresAtMost",
          "todayCourtMetres"
        ],
        "properties": {
          "siruta": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "county": {
            "type": "string"
          },
          "population": {
            "type": "integer",
            "minimum": 0
          },
          "courtMetres": {
            "type": "number",
            "minimum": 0
          },
          "hospitalMetresAtMost": {
            "type": "number",
            "minimum": 0
          },
          "localHealthProviderCount": {
            "type": "integer",
            "minimum": 0
          },
          "nearestHealthPointProviderId": {
            "type": "string",
            "minLength": 1
          },
          "nearestHealthPointDistanceMetres": {
            "description": "Straight-line distance from the consolidated UAT centroid to the nearest accepted provider point.",
            "type": "integer",
            "minimum": 0
          },
          "nearestHealthPointRoadProviderId": {
            "type": "string",
            "minLength": 1
          },
          "nearestHealthPointRoadProxyMetres": {
            "description": "Road-proxy distance from the consolidated UAT road node to the nearest accepted provider point snap.",
            "type": "integer",
            "minimum": 0
          },
          "comparable": {
            "type": "boolean"
          },
          "policeMetresAtMost": {
            "type": "number",
            "minimum": 0
          },
          "todayCourtMetres": {
            "type": "number",
            "minimum": 0
          }
        }
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "provenance.schema.json#/$defs/limitation"
      }
    }
  }
}
