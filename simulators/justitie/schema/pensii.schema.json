{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cristiannichifor.github.io/romania-reforms/schema/pensii.schema.json",
  "title": "The magistrates' service pension, current rule and the 2025 bill",
  "description": "Four things change at once, which is why the headline misleads in both directions: the rate falls from 80% to 55%, and the base widens from one month's indemnity to a five-year average that also counts sporuri. How much the second offsets the first depends on a number nobody publishes.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "title",
    "publisher",
    "period",
    "provenance",
    "current",
    "proposed",
    "byGrade",
    "limitations"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "publisher": {
      "type": "string"
    },
    "period": {
      "type": "string"
    },
    "provenance": {
      "$ref": "provenance.schema.json#/$defs/provenance"
    },
    "current": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "seniorityYears",
        "percent",
        "baseDescription",
        "netCapPercent",
        "provenance"
      ],
      "properties": {
        "seniorityYears": {
          "type": "integer"
        },
        "percent": {
          "type": "integer",
          "description": "Per cent of the calculation base."
        },
        "baseDescription": {
          "type": "string"
        },
        "netCapPercent": {
          "type": "integer"
        },
        "provenance": {
          "$ref": "provenance.schema.json#/$defs/provenance"
        }
      }
    },
    "proposed": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "seniorityYears",
        "percent",
        "baseDescription",
        "netCapPercent",
        "provenance"
      ],
      "properties": {
        "seniorityYears": {
          "type": "integer"
        },
        "percent": {
          "type": "integer",
          "description": "Per cent of the calculation base."
        },
        "baseDescription": {
          "type": "string"
        },
        "netCapPercent": {
          "type": "integer"
        },
        "provenance": {
          "$ref": "provenance.schema.json#/$defs/provenance"
        },
        "baseMonths": {
          "type": "integer"
        },
        "baseIncludesSporuri": {
          "type": "boolean"
        }
      }
    },
    "byGrade": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "grade",
          "monthlyLei",
          "currentLei",
          "proposedFloorLei",
          "reductionPercent"
        ],
        "properties": {
          "grade": {
            "type": "string"
          },
          "monthlyLei": {
            "type": "number"
          },
          "currentLei": {
            "type": "number"
          },
          "proposedFloorLei": {
            "type": "number",
            "description": "Indemnity only. The bill's base also counts sporuri, so this is the floor of the new pension and the ceiling of the reduction."
          },
          "reductionPercent": {
            "type": "number"
          }
        }
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "provenance.schema.json#/$defs/limitation"
      }
    }
  }
}
