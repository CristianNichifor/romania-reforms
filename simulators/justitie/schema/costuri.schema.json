{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cristiannichifor.github.io/romania-reforms/schema/costuri.schema.json",
  "title": "The base wage bill of the judiciary, and what consolidation does to it",
  "description": "Judges per court times what the law pays their grade. Two things the reform paper leaves open decide the answer between a saving and a half-billion-lei increase: the caseload a merged court runs at, and the grade its judges hold. Both are spanned rather than picked.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "title",
    "publisher",
    "period",
    "provenance",
    "monthlyLeiByTier",
    "today",
    "scenarios",
    "limitations",
    "resolvedGrade"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "publisher": {
      "type": "string"
    },
    "period": {
      "type": "string"
    },
    "provenance": {
      "$ref": "provenance.schema.json#/$defs/provenance"
    },
    "monthlyLeiByTier": {
      "type": "object",
      "additionalProperties": {
        "type": "number"
      }
    },
    "today": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "annualLei",
        "byTier",
        "levelOne"
      ],
      "properties": {
        "annualLei": {
          "type": "number"
        },
        "byTier": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "levelOne": {
          "type": "object",
          "additionalProperties": true
        }
      }
    },
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "target",
          "targetLabel",
          "gradePaid",
          "judgesNeeded",
          "annualLei",
          "differenceLei",
          "isPaperGrade"
        ],
        "properties": {
          "target": {
            "type": "number"
          },
          "targetLabel": {
            "type": "string"
          },
          "gradePaid": {
            "type": "string"
          },
          "judgesNeeded": {
            "type": "number"
          },
          "annualLei": {
            "type": "number"
          },
          "differenceLei": {
            "type": "number"
          },
          "isPaperGrade": {
            "description": "True for the grade the paper implies; the other grade is kept as a counterfactual.",
            "type": "boolean"
          }
        }
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "provenance.schema.json#/$defs/limitation"
      }
    },
    "resolvedGrade": {
      "description": "The grade the paper's own architecture implies for the merged level-1 court. Cited, not chosen.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "grade",
        "provenance"
      ],
      "properties": {
        "grade": {
          "enum": [
            "judecatorie",
            "tribunal"
          ]
        },
        "provenance": {
          "$ref": "provenance.schema.json#/$defs/provenance"
        }
      }
    }
  }
}
