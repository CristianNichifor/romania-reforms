{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cristiannichifor.github.io/romania-reforms/schema/curti-apel.schema.json",
  "title": "Variant: one appellate court per development region",
  "description": "The paper proposes ~15 appellate courts, which is the number that already exists. This models the alternative of eight, one per development region. It is a variant chosen by the author after seeing that, not the paper's proposal, and carries variantOfPaper so nothing can quote it as the document's own.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "title",
    "publisher",
    "period",
    "variantOfPaper",
    "provenance",
    "regions",
    "counties",
    "summary",
    "limitations"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "id": {
      "const": "curti-apel-regiuni"
    },
    "title": {
      "type": "string"
    },
    "publisher": {
      "type": "string"
    },
    "period": {
      "type": "string"
    },
    "variantOfPaper": {
      "description": "Always true. This document does not model what the paper says.",
      "const": true
    },
    "provenance": {
      "$ref": "provenance.schema.json#/$defs/provenance"
    },
    "regions": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "region",
          "counties",
          "seat",
          "seatSiruta",
          "seatCounty",
          "absorbs",
          "courtsToday",
          "volume",
          "judges"
        ],
        "properties": {
          "region": {
            "type": "string"
          },
          "counties": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "string"
            }
          },
          "seat": {
            "type": "string"
          },
          "seatSiruta": {
            "type": "string"
          },
          "seatCounty": {
            "type": "string"
          },
          "absorbs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "courtsToday": {
            "type": "integer",
            "exclusiveMinimum": 0
          },
          "volume": {
            "type": "number",
            "minimum": 0
          },
          "judges": {
            "type": "number",
            "minimum": 0
          }
        }
      }
    },
    "counties": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "county",
          "region",
          "metresToRegionSeat",
          "metresToNearestToday"
        ],
        "properties": {
          "county": {
            "type": "string"
          },
          "region": {
            "type": "string"
          },
          "metresToRegionSeat": {
            "type": "number",
            "minimum": 0
          },
          "metresToNearestToday": {
            "type": "number",
            "minimum": 0
          }
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "today",
        "variant",
        "absorbed",
        "meanMetresToNearestToday",
        "meanMetresToRegionSeat",
        "countiesTravellingFurther",
        "countiesCompared"
      ],
      "properties": {
        "today": {
          "const": 15
        },
        "variant": {
          "const": 8
        },
        "absorbed": {
          "type": "integer"
        },
        "meanMetresToNearestToday": {
          "type": "number"
        },
        "meanMetresToRegionSeat": {
          "type": "number"
        },
        "countiesTravellingFurther": {
          "type": "integer"
        },
        "countiesCompared": {
          "type": "integer"
        }
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "provenance.schema.json#/$defs/limitation"
      }
    }
  }
}
