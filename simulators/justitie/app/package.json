{
  "name": "justitie-app",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "node scripts/copy-data.mjs && node scripts/build-acces.mjs",
    "dev": "vite",
    "prebuild": "node scripts/copy-data.mjs && node scripts/build-acces.mjs",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run src",
    "check:ui": "tsc --project tsconfig.browser.json && playwright test"
  },
  "dependencies": {
    "maplibre-gl": "^6.6.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "^22.20.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vitest": "^4.1.11"
  }
}
