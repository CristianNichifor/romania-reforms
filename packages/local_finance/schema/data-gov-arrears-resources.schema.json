{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cristiannichifor.github.io/romania-reforms/packages/local_finance/schema/data-gov-arrears-resources.schema.json",
  "title": "data.gov.ro Arierate UAT resource index",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "id",
    "title",
    "publisher",
    "license",
    "retrievedDate",
    "provenance",
    "sourceHashes",
    "summary",
    "latestUatResource",
    "uatResources",
    "limitations"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "id": { "const": "data-gov-ro-arrears-resources" },
    "title": { "type": "string", "minLength": 1 },
    "publisher": { "type": "string", "minLength": 1 },
    "license": { "type": "string", "minLength": 1 },
    "retrievedDate": { "type": "string", "format": "date" },
    "provenance": {
      "$ref": "https://cristiannichifor.github.io/romania-reforms/schema/provenance.schema.json#/$defs/provenance"
    },
    "sourceHashes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ckanPackageSha256"],
      "properties": {
        "ckanPackageSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "resources",
        "uatResources",
        "firstUatSnapshotDate",
        "latestUatSnapshotDate",
        "coveredYears",
        "has2025UatResource"
      ],
      "properties": {
        "resources": { "type": "integer", "minimum": 0 },
        "uatResources": { "type": "integer", "minimum": 0 },
        "firstUatSnapshotDate": { "type": ["string", "null"], "format": "date" },
        "latestUatSnapshotDate": { "type": ["string", "null"], "format": "date" },
        "coveredYears": {
          "type": "array",
          "items": { "type": "integer", "minimum": 2000 },
          "uniqueItems": true
        },
        "has2025UatResource": { "type": "boolean" }
      }
    },
    "latestUatResource": {
      "anyOf": [{ "$ref": "#/$defs/resource" }, { "type": "null" }]
    },
    "uatResources": {
      "type": "array",
      "items": { "$ref": "#/$defs/resource" }
    },
    "limitations": {
      "type": "array",
      "items": {
        "$ref": "https://cristiannichifor.github.io/romania-reforms/schema/provenance.schema.json#/$defs/limitation"
      }
    }
  },
  "$defs": {
    "resource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "snapshotDate",
        "year",
        "month",
        "resourceId",
        "name",
        "url",
        "format",
        "created",
        "lastModified",
        "duplicateResources"
      ],
      "properties": {
        "snapshotDate": { "type": "string", "format": "date" },
        "year": { "type": "integer", "minimum": 2000 },
        "month": { "type": "integer", "minimum": 1, "maximum": 12 },
        "resourceId": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "name": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "minLength": 1 },
        "format": { "type": "string", "minLength": 1 },
        "created": { "type": ["string", "null"] },
        "lastModified": { "type": ["string", "null"] },
        "duplicateResources": { "type": "integer", "minimum": 1 }
      }
    }
  }
}
