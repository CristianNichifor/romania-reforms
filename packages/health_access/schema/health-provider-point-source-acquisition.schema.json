{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cristiannichifor.github.io/romania-reforms/packages/health_access/schema/health-provider-point-source-acquisition.schema.json",
  "title": "Health provider point source acquisition queue",
  "description": "Source-acquisition queue for service-eligible health providers that remain blocked from point routing because no accepted point evidence is attached.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "id",
    "title",
    "publisher",
    "scope",
    "periodStart",
    "periodEnd",
    "retrievedDate",
    "provenance",
    "registry",
    "sourceHashes",
    "transform",
    "summary",
    "sourceTypes",
    "acceptanceRules",
    "records",
    "limitations"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "id": { "const": "health-provider-point-source-acquisition-2024-2026" },
    "title": { "type": "string", "minLength": 1 },
    "publisher": { "const": "Cristian Nichifor" },
    "scope": { "const": "provider-point-source-acquisition" },
    "periodStart": { "const": "2024" },
    "periodEnd": { "const": "2026" },
    "retrievedDate": { "type": "string", "format": "date" },
    "provenance": {
      "$ref": "https://cristiannichifor.github.io/romania-reforms/schema/provenance.schema.json#/$defs/provenance"
    },
    "registry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["providerPoints", "providerPointReview"],
      "properties": {
        "providerPoints": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "periodStart", "periodEnd"],
          "properties": {
            "id": { "const": "health-provider-points-2024-2026" },
            "periodStart": { "const": "2024" },
            "periodEnd": { "const": "2026" }
          }
        },
        "providerPointReview": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "periodStart", "periodEnd"],
          "properties": {
            "id": { "const": "health-provider-point-evidence-review-2024-2026" },
            "periodStart": { "const": "2024" },
            "periodEnd": { "const": "2026" }
          }
        }
      }
    },
    "sourceHashes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["providerPointsSha256", "providerPointReviewSha256"],
      "properties": {
        "providerPointsSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "providerPointReviewSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "transform": {
      "type": "object",
      "additionalProperties": false,
      "required": ["script", "version"],
      "properties": {
        "script": {
          "const": "packages/health_access/scripts/build_health_provider_point_source_acquisition.py"
        },
        "version": { "type": "integer", "minimum": 1 }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "providerPoints",
        "pointAccessEligibleProviders",
        "pointAccessBlockedProviders",
        "reviewProviders",
        "acquisitionProviders",
        "localityOnlyCandidateProviders",
        "noMinistryCandidateProviders",
        "publicBedNoCandidateProviders",
        "acquisitionStatus",
        "acquisitionPriority",
        "sourceSearchTypes",
        "ownerTypes",
        "byCounty"
      ],
      "properties": {
        "providerPoints": { "type": "integer", "minimum": 1 },
        "pointAccessEligibleProviders": { "type": "integer", "minimum": 0 },
        "pointAccessBlockedProviders": { "type": "integer", "minimum": 0 },
        "reviewProviders": { "type": "integer", "minimum": 0 },
        "acquisitionProviders": { "type": "integer", "minimum": 0 },
        "localityOnlyCandidateProviders": { "type": "integer", "minimum": 0 },
        "noMinistryCandidateProviders": { "type": "integer", "minimum": 0 },
        "publicBedNoCandidateProviders": { "type": "integer", "minimum": 0 },
        "acquisitionStatus": {
          "type": "object",
          "additionalProperties": { "type": "integer", "minimum": 0 }
        },
        "acquisitionPriority": {
          "type": "object",
          "additionalProperties": { "type": "integer", "minimum": 0 }
        },
        "sourceSearchTypes": {
          "type": "object",
          "additionalProperties": { "type": "integer", "minimum": 0 }
        },
        "ownerTypes": {
          "type": "object",
          "additionalProperties": { "type": "integer", "minimum": 0 }
        },
        "byCounty": {
          "type": "array",
          "items": { "$ref": "#/$defs/countySummary" }
        }
      }
    },
    "sourceTypes": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/sourceType" }
    },
    "acceptanceRules": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/acceptanceRule" }
    },
    "records": {
      "type": "array",
      "items": { "$ref": "#/$defs/acquisitionRecord" }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "https://cristiannichifor.github.io/romania-reforms/schema/provenance.schema.json#/$defs/limitation"
      }
    }
  },
  "$defs": {
    "sourceTypeId": {
      "enum": [
        "provider-official-website",
        "dsp-or-local-authority-list",
        "cnas-or-official-contracting-list",
        "osm-named-feature-manual-review",
        "ministry-locality-candidate-provider-verification"
      ]
    },
    "evidenceType": {
      "enum": [
        "provider-published-street-address",
        "provider-published-coordinate",
        "official-authority-street-address",
        "official-authority-coordinate",
        "named-osm-feature-coordinate",
        "verified-ministry-source-row-alias"
      ]
    },
    "sourceType": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "acceptedEvidence"],
      "properties": {
        "id": { "$ref": "#/$defs/sourceTypeId" },
        "label": { "type": "string", "minLength": 1 },
        "acceptedEvidence": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/evidenceType" },
          "uniqueItems": true
        }
      }
    },
    "acceptanceRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "text"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "text": { "type": "string", "minLength": 1 }
      }
    },
    "acquisitionStatus": {
      "enum": ["needs-provider-specific-evidence", "needs-new-source"]
    },
    "acquisitionPriority": {
      "enum": [
        "p1-locality-candidate-needs-provider-evidence",
        "p2-public-bed-provider-no-ministry-candidate",
        "p3-public-provider-no-ministry-candidate",
        "p4-private-or-unknown-provider-no-ministry-candidate"
      ]
    },
    "candidateStatus": {
      "enum": [
        "has-unused-ministry-review-candidate",
        "no-ministry-review-candidate"
      ]
    },
    "nextAction": {
      "enum": [
        "verify-locality-only-ministry-candidate-with-provider-source",
        "find-provider-specific-address-or-coordinate-source"
      ]
    },
    "countySummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "countyCode",
        "countyName",
        "acquisitionProviders",
        "localityOnlyCandidateProviders",
        "noMinistryCandidateProviders",
        "publicBedNoCandidateProviders"
      ],
      "properties": {
        "countyCode": { "type": "string", "pattern": "^[A-Z]{1,2}$" },
        "countyName": { "type": "string", "minLength": 1 },
        "acquisitionProviders": { "type": "integer", "minimum": 0 },
        "localityOnlyCandidateProviders": { "type": "integer", "minimum": 0 },
        "noMinistryCandidateProviders": { "type": "integer", "minimum": 0 },
        "publicBedNoCandidateProviders": { "type": "integer", "minimum": 0 }
      }
    },
    "acquisitionRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "providerId",
        "name",
        "countyCode",
        "countyName",
        "siruta",
        "localityName",
        "locationConfidence",
        "ownerType",
        "bedCount",
        "specialties",
        "candidateStatus",
        "reviewSignal",
        "candidateCount",
        "ministryCandidateSourceRecordIds",
        "candidateReviewMethods",
        "acquisitionStatus",
        "acquisitionPriority",
        "sourceSearchOrder",
        "acceptableEvidence",
        "nextAction"
      ],
      "properties": {
        "providerId": { "type": "string", "pattern": "^anmcs-2025-[0-9]{3}$" },
        "name": { "type": "string", "minLength": 1 },
        "countyCode": { "type": "string", "pattern": "^[A-Z]{1,2}$" },
        "countyName": { "type": "string", "minLength": 1 },
        "siruta": { "type": "string", "pattern": "^[0-9]+$" },
        "localityName": { "type": "string", "minLength": 1 },
        "locationConfidence": {
          "enum": ["name-derived-locality", "municipality-from-county"]
        },
        "ownerType": { "enum": ["public", "private", "unknown"] },
        "bedCount": { "type": ["number", "null"], "minimum": 0 },
        "specialties": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "candidateStatus": { "$ref": "#/$defs/candidateStatus" },
        "reviewSignal": { "enum": ["low", "none"] },
        "candidateCount": { "type": "integer", "minimum": 0 },
        "ministryCandidateSourceRecordIds": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^ms-unitati-sanitare-[0-9]{3}$"
          },
          "uniqueItems": true
        },
        "candidateReviewMethods": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "acquisitionStatus": { "$ref": "#/$defs/acquisitionStatus" },
        "acquisitionPriority": { "$ref": "#/$defs/acquisitionPriority" },
        "sourceSearchOrder": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/sourceTypeId" },
          "uniqueItems": true
        },
        "acceptableEvidence": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/evidenceType" },
          "uniqueItems": true
        },
        "nextAction": { "$ref": "#/$defs/nextAction" }
      }
    }
  }
}
