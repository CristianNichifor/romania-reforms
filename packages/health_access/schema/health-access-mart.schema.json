{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cristiannichifor.github.io/romania-reforms/packages/health_access/schema/health-access-mart.schema.json",
  "title": "Shared health access mart",
  "description": "Provider-level health access mart built from Ministry of Health bed workbooks and ANMCS accreditation data. Provider bed counts are present only where the clinical-beds workbook can be confidently matched to ANMCS.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "id",
    "title",
    "publisher",
    "scope",
    "periodStart",
    "periodEnd",
    "retrievedDate",
    "provenance",
    "registry",
    "sourceHashes",
    "transform",
    "summary",
    "countyTotals",
    "records",
    "exclusions",
    "limitations"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "id": {
      "enum": ["health-access-mart-2024-2025", "health-access-mart-sample-2024-2025"]
    },
    "title": { "type": "string", "minLength": 1 },
    "publisher": { "const": "Ministerul Sanatatii / ANMCS" },
    "scope": { "enum": ["national", "sample"] },
    "periodStart": { "const": "2024" },
    "periodEnd": { "const": "2025" },
    "retrievedDate": { "type": "string", "format": "date" },
    "provenance": {
      "$ref": "https://cristiannichifor.github.io/romania-reforms/schema/provenance.schema.json#/$defs/provenance"
    },
    "registry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "period"],
      "properties": {
        "id": { "type": "string", "pattern": "^uat-registry-[0-9]{4}$" },
        "period": { "type": "string", "pattern": "^[0-9]{4}$" }
      }
    },
    "sourceHashes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "hospitalBedsWorkbookSha256",
        "clinicalBedsWorkbookSha256",
        "anmcsWorkbookSha256",
        "uatRegistrySha256"
      ],
      "properties": {
        "hospitalBedsWorkbookSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "clinicalBedsWorkbookSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "anmcsWorkbookSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "uatRegistrySha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "transform": {
      "type": "object",
      "additionalProperties": false,
      "required": ["script", "version"],
      "properties": {
        "script": { "const": "packages/health_access/scripts/import_health_access.py" },
        "version": { "type": "integer", "minimum": 1 }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scopeCounties",
        "records",
        "anmcsProviders",
        "clinicalBedRows",
        "matchedClinicalBedRows",
        "providersWithClinicalBeds",
        "providersWithoutClinicalBeds",
        "providersWithSiruta",
        "providerLevelClinicalBeds",
        "countyTotalBeds",
        "namedExclusions",
        "locationConfidence",
        "byCounty"
      ],
      "properties": {
        "scopeCounties": {
          "type": "array",
          "items": { "type": "string", "pattern": "^[A-Z]{1,2}$" },
          "uniqueItems": true,
          "minItems": 1
        },
        "records": { "type": "integer", "minimum": 1 },
        "anmcsProviders": { "type": "integer", "minimum": 1 },
        "clinicalBedRows": { "type": "integer", "minimum": 1 },
        "matchedClinicalBedRows": { "type": "integer", "minimum": 0 },
        "providersWithClinicalBeds": { "type": "integer", "minimum": 0 },
        "providersWithoutClinicalBeds": { "type": "integer", "minimum": 0 },
        "providersWithSiruta": { "type": "integer", "minimum": 0 },
        "providerLevelClinicalBeds": { "type": "number", "minimum": 0 },
        "countyTotalBeds": { "type": "number", "minimum": 0 },
        "namedExclusions": { "type": "integer", "minimum": 1 },
        "locationConfidence": {
          "type": "object",
          "additionalProperties": { "type": "integer", "minimum": 0 }
        },
        "byCounty": {
          "type": "array",
          "minItems": 2,
          "items": { "$ref": "#/$defs/countySummary" }
        }
      }
    },
    "countyTotals": {
      "type": "array",
      "minItems": 2,
      "items": { "$ref": "#/$defs/countyTotal" }
    },
    "records": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/provider" }
    },
    "exclusions": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/exclusion" }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "https://cristiannichifor.github.io/romania-reforms/schema/provenance.schema.json#/$defs/limitation"
      }
    }
  },
  "$defs": {
    "countySummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "countyCode",
        "countyName",
        "anmcsProviders",
        "providersWithClinicalBeds",
        "providersWithSiruta",
        "countyTotalBeds",
        "matchedClinicalBeds"
      ],
      "properties": {
        "countyCode": { "type": "string", "pattern": "^[A-Z]{1,2}$" },
        "countyName": { "type": "string", "minLength": 1 },
        "anmcsProviders": { "type": "integer", "minimum": 0 },
        "providersWithClinicalBeds": { "type": "integer", "minimum": 0 },
        "providersWithSiruta": { "type": "integer", "minimum": 0 },
        "countyTotalBeds": { "type": ["number", "null"], "minimum": 0 },
        "matchedClinicalBeds": { "type": "number", "minimum": 0 }
      }
    },
    "countyTotal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["countyCode", "countyName", "totalBeds", "sourceRow"],
      "properties": {
        "countyCode": { "type": "string", "pattern": "^[A-Z]{1,2}$" },
        "countyName": { "type": "string", "minLength": 1 },
        "totalBeds": { "type": "number", "minimum": 0 },
        "sourceRow": { "type": "integer", "minimum": 1 }
      }
    },
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "providerId",
        "name",
        "countyCode",
        "countyName",
        "siruta",
        "localityName",
        "locationConfidence",
        "ownerType",
        "bedCount",
        "specialties",
        "specialtyBeds",
        "accreditationCategory",
        "accreditationScore",
        "accreditationDecision",
        "accreditationOrder",
        "accreditationPeriod",
        "sourceRows"
      ],
      "properties": {
        "providerId": { "type": "string", "pattern": "^anmcs-2025-[0-9]{3}$" },
        "name": { "type": "string", "minLength": 1 },
        "countyCode": { "type": "string", "pattern": "^[A-Z]{1,2}$" },
        "countyName": { "type": "string", "minLength": 1 },
        "siruta": { "type": ["string", "null"], "pattern": "^[0-9]+$" },
        "localityName": { "type": ["string", "null"], "minLength": 1 },
        "locationConfidence": {
          "enum": ["name-derived-locality", "municipality-from-county", "county-only"]
        },
        "ownerType": { "enum": ["public", "private", "unknown"] },
        "bedCount": { "type": ["number", "null"], "minimum": 0 },
        "specialties": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "specialtyBeds": {
          "type": "object",
          "additionalProperties": { "type": "number", "minimum": 0 }
        },
        "accreditationCategory": { "type": ["string", "null"], "minLength": 1 },
        "accreditationScore": { "type": ["number", "null"], "minimum": 0 },
        "accreditationDecision": { "type": ["string", "null"], "minLength": 1 },
        "accreditationOrder": { "type": ["string", "null"], "minLength": 1 },
        "accreditationPeriod": { "type": ["string", "null"], "minLength": 1 },
        "sourceRows": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "anmcsOrdinal",
            "anmcsSheetRow",
            "clinicalBedsRow",
            "clinicalBedsSheetRow"
          ],
          "properties": {
            "anmcsOrdinal": { "type": "integer", "minimum": 1 },
            "anmcsSheetRow": { "type": "integer", "minimum": 1 },
            "clinicalBedsRow": { "type": ["integer", "null"], "minimum": 1 },
            "clinicalBedsSheetRow": { "type": ["integer", "null"], "minimum": 1 }
          }
        }
      }
    },
    "exclusion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "source", "name", "countyCode", "reason"],
      "properties": {
        "kind": {
          "enum": [
            "anmcs-provider-without-clinical-bed-row",
            "clinical-bed-row-without-selected-anmcs-match",
            "provider-without-uat-location"
          ]
        },
        "source": { "enum": ["anmcs", "clinical-beds"] },
        "name": { "type": "string", "minLength": 1 },
        "countyCode": { "type": ["string", "null"], "pattern": "^[A-Z]{1,2}$" },
        "reason": { "type": "string", "minLength": 1 }
      }
    }
  }
}
