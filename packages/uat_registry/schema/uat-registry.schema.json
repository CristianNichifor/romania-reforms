{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cristiannichifor.github.io/romania-reforms/packages/uat_registry/schema/uat-registry.schema.json",
  "title": "Shared SIRUTA UAT registry",
  "description": "Canonical UAT-level rows selected from INS SIRUTA and enriched with a CUI crosswalk. This file is a join registry, not a full locality gazetteer.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "id",
    "title",
    "publisher",
    "period",
    "retrievedDate",
    "provenance",
    "crosswalkProvenance",
    "sourceHashes",
    "transform",
    "summary",
    "units",
    "limitations"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "id": { "type": "string", "pattern": "^uat-registry-[0-9]{4}$" },
    "title": { "type": "string", "minLength": 1 },
    "publisher": { "const": "Institutul National de Statistica" },
    "period": { "type": "string", "pattern": "^[0-9]{4}$" },
    "retrievedDate": { "type": "string", "format": "date" },
    "provenance": {
      "$ref": "https://cristiannichifor.github.io/romania-reforms/schema/provenance.schema.json#/$defs/provenance"
    },
    "crosswalkProvenance": {
      "$ref": "https://cristiannichifor.github.io/romania-reforms/schema/provenance.schema.json#/$defs/provenance"
    },
    "sourceHashes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sirutaSha256", "crosswalkSha256"],
      "properties": {
        "sirutaSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "crosswalkSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "transform": {
      "type": "object",
      "additionalProperties": false,
      "required": ["script", "version"],
      "properties": {
        "script": { "type": "string", "minLength": 1 },
        "version": { "type": "integer", "minimum": 1 }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "registryRows",
        "localAuthorityRows",
        "countyRows",
        "withCui",
        "withoutCui",
        "withPopulation",
        "crosswalkRows",
        "crosswalkMatched",
        "crosswalkUnmatched",
        "crosswalkMatchedBy",
        "byLevel"
      ],
      "properties": {
        "registryRows": { "type": "integer", "minimum": 1 },
        "localAuthorityRows": { "type": "integer", "minimum": 0 },
        "countyRows": { "type": "integer", "minimum": 0 },
        "withCui": { "type": "integer", "minimum": 0 },
        "withoutCui": { "type": "integer", "minimum": 0 },
        "withPopulation": { "type": "integer", "minimum": 0 },
        "crosswalkRows": { "type": "integer", "minimum": 0 },
        "crosswalkMatched": { "type": "integer", "minimum": 0 },
        "crosswalkUnmatched": { "type": "integer", "minimum": 0 },
        "crosswalkMatchedBy": {
          "type": "object",
          "additionalProperties": false,
          "required": ["siruta", "countyCode"],
          "properties": {
            "siruta": { "type": "integer", "minimum": 0 },
            "countyCode": { "type": "integer", "minimum": 0 }
          }
        },
        "byLevel": {
          "type": "object",
          "additionalProperties": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "units": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/unit" }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "https://cristiannichifor.github.io/romania-reforms/schema/provenance.schema.json#/$defs/limitation"
      }
    }
  },
  "$defs": {
    "unit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "siruta",
        "name",
        "shortName",
        "level",
        "countyCode",
        "countyName",
        "countySiruta",
        "parentSiruta",
        "sirutaType",
        "sirutaLevel",
        "lau",
        "nuts3",
        "population",
        "cui",
        "cuiSource",
        "crosswalkKey"
      ],
      "properties": {
        "siruta": { "type": "string", "pattern": "^[0-9]+$" },
        "name": { "type": "string", "minLength": 1 },
        "shortName": { "type": "string", "minLength": 1 },
        "level": {
          "enum": ["county", "municipality", "town", "commune", "sector"]
        },
        "countyCode": { "type": "string", "pattern": "^[A-Z]{1,2}$" },
        "countyName": { "type": "string", "minLength": 1 },
        "countySiruta": { "type": "string", "pattern": "^[0-9]+$" },
        "parentSiruta": { "type": ["string", "null"], "pattern": "^[0-9]+$" },
        "sirutaType": { "type": "integer", "minimum": 1 },
        "sirutaLevel": { "type": "integer", "minimum": 1 },
        "lau": { "type": ["string", "null"] },
        "nuts3": { "type": ["string", "null"] },
        "population": { "type": ["integer", "null"], "minimum": 0 },
        "cui": { "type": ["string", "null"], "pattern": "^[0-9]+$" },
        "cuiSource": { "type": ["string", "null"] },
        "crosswalkKey": { "type": ["string", "null"], "minLength": 1 }
      }
    }
  }
}
