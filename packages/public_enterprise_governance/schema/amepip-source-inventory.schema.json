{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cristiannichifor.github.io/romania-reforms/packages/public_enterprise_governance/schema/amepip-source-inventory.schema.json",
  "title": "AMEPIP public enterprise source inventory",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "id",
    "title",
    "publisher",
    "license",
    "retrievedDate",
    "provenance",
    "summary",
    "sources",
    "limitations",
    "nextSlice"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "id": { "const": "amepip-source-inventory-2025-2026" },
    "title": { "type": "string", "minLength": 1 },
    "publisher": { "type": "string", "minLength": 1 },
    "license": { "type": "string", "minLength": 1 },
    "retrievedDate": { "type": "string", "format": "date" },
    "provenance": {
      "$ref": "https://cristiannichifor.github.io/romania-reforms/schema/provenance.schema.json#/$defs/provenance"
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceDocuments",
        "kpiDocuments",
        "compensationDocuments",
        "documentsWithCui",
        "documentsWithCompanyIndicatorRows",
        "preferredFirstParserTarget",
        "decision"
      ],
      "properties": {
        "sourceDocuments": { "type": "integer", "minimum": 0 },
        "kpiDocuments": { "type": "integer", "minimum": 0 },
        "compensationDocuments": { "type": "integer", "minimum": 0 },
        "documentsWithCui": { "type": "integer", "minimum": 0 },
        "documentsWithCompanyIndicatorRows": { "type": "integer", "minimum": 0 },
        "preferredFirstParserTarget": { "type": "string", "minLength": 1 },
        "decision": { "enum": ["planned", "deferred"] }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/source" }
    },
    "limitations": {
      "type": "array",
      "items": {
        "$ref": "https://cristiannichifor.github.io/romania-reforms/schema/provenance.schema.json#/$defs/limitation"
      }
    },
    "nextSlice": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scope", "deliverable", "doneWhen"],
      "properties": {
        "scope": { "type": "string", "minLength": 1 },
        "deliverable": { "type": "string", "minLength": 1 },
        "doneWhen": { "type": "string", "minLength": 1 }
      }
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "family",
        "sourcePageUrl",
        "downloadUrl",
        "fileType",
        "sha256",
        "pageCount",
        "rowEstimate",
        "identity",
        "usefulFields",
        "parserUse",
        "notes"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
        "title": { "type": "string", "minLength": 1 },
        "family": { "enum": ["kpi-report", "kpi-annex", "compensation"] },
        "sourcePageUrl": { "type": "string", "format": "uri" },
        "downloadUrl": { "type": "string", "format": "uri" },
        "fileType": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "pageCount": { "type": "integer", "minimum": 1 },
        "rowEstimate": {
          "type": "object",
          "additionalProperties": false,
          "required": ["method", "rows"],
          "properties": {
            "method": { "type": "string", "minLength": 1 },
            "rows": { "type": "integer", "minimum": 0 }
          }
        },
        "identity": {
          "type": "object",
          "additionalProperties": false,
          "required": ["hasCui", "stableFields"],
          "properties": {
            "hasCui": { "type": "boolean" },
            "stableFields": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 },
              "uniqueItems": true
            }
          }
        },
        "usefulFields": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "parserUse": { "enum": ["first-target", "later-target", "reference-only", "defer"] },
        "notes": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
