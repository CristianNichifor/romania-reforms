  "limitations": [
    {
      "id": "amepip-reuse-license-not-published",
      "text": "The AMEPIP source pages publish official PDFs but do not publish explicit reusable data/export terms. Imported row-level payloads must carry this limitation until licensing is clarified.",
      "severity": "material",
      "affects": ["all-amepip-imports"]
    },
    {
      "id": "amepip-pdf-layout-sensitive",
      "text": "The inspected sources are PDFs. Row counts come from pdftotext/pdfplumber extraction and wrapped cells can split rows; a production importer must validate row counts and identifier coverage for each source file.",
      "severity": "material",
      "affects": ["parser", "row-counts"]
    },
    {
      "id": "amepip-powerbi-not-import-source",
      "text": "The public Power BI dashboard remains context only. It must not be scraped as source-of-truth data unless AMEPIP publishes an explicit export or API path with provenance and reuse terms.",
      "severity": "blocking",
      "affects": ["dashboard-data"]
    },
    {
      "id": "amepip-listing-annexes-without-cui",
      "text": "Annexes 5 and 6 expose useful listing recommendations but no visible CUI in the inspected table text. They require a CUI crosswalk from another official source before simulator use.",
      "severity": "material",
      "affects": ["listing-readiness"]
    }
  ],
